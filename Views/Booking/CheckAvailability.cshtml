@using WorkingSpaces.Models
@{
    ViewData["Title"] = "Check Availability";
    var spaces = ViewBag.Spaces as List<Space> ?? new List<Space>();
}

<form method="post" class="booking-form" asp-action="CheckAvailability">
    @Html.AntiForgeryToken()
    <h2>Check Room Availability</h2>
    @if(ViewBag.Result != null)
    {
        bool isError = ((string)ViewBag.Result).StartsWith("Error");
        <p class="result @(isError ? "result-error" : "result-success")">
            @ViewBag.Result
        </p>
    }
    <label>Room:</label>
    <select name="spaceId" required class="form-control" style="width: 100%; padding: 8px 10px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box;">
        <option value="">--Choose room--</option>
        @foreach (var space in spaces)
        {
            <option value="@space.SpaceId">@space.Name</option>
        }
    </select>
    
    <label>Date:</label>
    <input type="date" name="selectedDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
    
    <label>Start Time:</label>
    <input type="time" name="startTime" required /> 
    
    <label>End Time:</label>
    <input type="time" name="endTime" required />
    
    <button type="submit">Check</button>
</form>

@if(ViewBag.Result != null)
{
    <p class="result">@ViewBag.Result</p>
}

<style>
    body {
        background-color: #f5f4f8;
    }

    .booking-form {
        max-width: 400px;
        margin: 150px auto;
        padding: 25px;
        background-color: #ffffff;
        border-radius: 12px;
        color: #333;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    .booking-form label {
        display: block;
        margin-bottom: 6px;
        font-weight: bold;
        color: #4b0082;
    }

    .booking-form input {
        width: 100%;
        padding: 8px 10px;
        margin-bottom: 15px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-sizing: border-box;
    }

    .booking-form button {
        width: 100%;
        padding: 10px;
        background-color: #6a0dad;
        color: #fff;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
        transition: background-color 0.2s;
    }

    .booking-form button:hover {
        background-color: #4b0082;
    }

    .result {
        text-align: center;
        margin-top: 0px;
        margin-bottom: 15px;
        font-weight: bold;
        padding: 10px;
        border-radius: 6px;
    }
    .result-error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
    .result-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
</style>
