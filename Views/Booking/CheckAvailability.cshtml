@{
    ViewData["Title"] = "Check Availability";
}

<h2>Check Room Availability</h2>

<form method="post" class="booking-form">
    <label>Date:</label>
    <input type="date" name="date" required />
    
    <label>Room:</label>
    <input type="text" name="room" placeholder="Enter room name" required />
    
    <button type="submit">Check</button>
</form>

@if(ViewBag.Result != null)
{
    <p class="result">@ViewBag.Result</p>
}

<style>
.booking-form {
    max-width: 400px;
    margin: 20px auto;
    padding: 20px;
    background: #f5f5f5;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
}
.booking-form label {
    margin-top: 10px;
    font-weight: bold;
}
.booking-form input {
    padding: 8px;
    margin-top: 4px;
    border-radius: 4px;
    border: 1px solid #ccc;
}
.booking-form button {
    margin-top: 15px;
    padding: 10px;
    background-color: #007dc1;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
}
.booking-form button:hover {
    background-color: #005a8b;
}
.result {
    margin-top: 15px;
    font-weight: bold;
    color: #007dc1;
}
.description {
    margin-top: 20px;
    font-style: italic;
    color: #555;
}
</style>
