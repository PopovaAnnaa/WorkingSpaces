@model List<WorkingSpaces.Models.Booking>
@using System.Security.Claims
@{
    ViewData["Title"] = "Cancel My Bookings";
}

<h2>Cancel Booking</h2>
@if(TempData["CancelResult"] != null)
{
    string result = TempData["CancelResult"] as string ?? string.Empty;
    bool isError = result.StartsWith("Error");
    <p class="result @(isError ? "result-error" : "result-success")">
        @result
    </p>
}
<table border="1">
    <thead>
        <tr>
            <th>ID</th>
            <th>Room</th>
            <th>Date</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Action</th> </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.BookingId</td>
                <td>@booking.Space.Name</td>
                <td>@booking.StartTime.ToString("dd.MM.yyyy")</td>
                <td>@booking.StartTime.ToString("HH:mm")</td>
                <td>@booking.EndTime.ToString("HH:mm")</td>
                <td>
                    <form method="post" asp-action="CancelBooking" 
                          onsubmit="return confirm('Are you sure about your choice?');">
                        
                        <input type="hidden" name="bookingId" value="@booking.BookingId" />
                        
                        @Html.AntiForgeryToken()
                        
                        <button type="submit" class="cancel-btn">
                            Cancel
                        </button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6">You have no active bookings.</td>
            </tr>
        }
    </tbody>
</table>

<style>
    body {
        background-color: #f5f4f8;
    }
    h2 {
        text-align: center;
        margin-bottom: 25px;
        margin-top: 50px;
    }
    table {
        width: 80%;
        margin: 0 auto;
        border-collapse: collapse;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }
    th, td {
        padding: 12px 15px;
        text-align: center;
        border-bottom: 1px solid #ddd;
    }
    th {
        background-color: #6a0dad;
        color: #fff;
        font-weight: bold;
    }
    tr:nth-child(even) {
        background-color: #f9f9f9;
    }
    tr:hover {
        background-color: #ece0f8;
    }
    .cancel-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        transition: background-color 0.2s;
    }
    .cancel-btn:hover {
        background-color: #c82333;
    }

    .result {
        text-align: center;
        max-width: 80%;
        margin: 20px auto;
        font-weight: bold;
        padding: 10px;
        border-radius: 6px;
    }
    .result-error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
    .result-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
</style>
