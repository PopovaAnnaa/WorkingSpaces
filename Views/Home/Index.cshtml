@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="overlay"></div>
    <div class="hero-content">
        <p class="location">Kyiv, Ukraine</p>
        <h1>Find Your Next <br /> Coworking space</h1>
        <p class="subtitle">
            Discover a coworking space designed for innovators, <br />
            creators and entrepreneurs
        </p>
    </div>
</section>

<style>
    .hero {
        position: relative;
        height: 90vh;
        background: url('/img/hero.jpeg') no-repeat center center/cover;
        display: flex;
        align-items: center;
        padding-left: 60px;
    }

    .overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: linear-gradient(to right, rgba(64,0,128,0.6), rgba(0,0,0,0));
    }

    .hero-content {
        position: relative;
        color: #fff;
        max-width: 500px;
    }

    .hero-content .location {
        font-size: 14px;
        margin-bottom: 10px;
    }

    .hero-content h1 {
        font-size: 48px;
        line-height: 1.2;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .hero-content .subtitle {
        font-size: 18px;
        margin-bottom: 30px;
    }

    .cta-btn {
        display: inline-block;
        border: 2px solid #fff;
        padding: 10px 25px;
        border-radius: 25px;
        font-weight: 600;
        text-decoration: none;
        color: #fff;
        transition: background 0.3s ease, color 0.3s ease;
    }

    .cta-btn:hover {
        background: #fff;
        color: #3b1053;
    }

    .welcome {
    text-align: center;
    margin-top: 80px;
    color: #333;
    }

    .welcome h1 {
    font-size: 2em;
    margin-bottom: 20px;
    }

    .welcome p {
    font-size: 1.1em;
    width: 60%;
    margin: 0 auto 30px;
    line-height: 1.6;
    }

    .btn {
    background-color: #0078d7;
    color: white;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.3s;
    }

    .btn:hover {
    background-color: #005fa3;
    }
</style>