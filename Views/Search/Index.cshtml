@model WorkspaceApp.Models.BookingSearchViewModel

@{
    ViewData["Title"] = "Search Bookings";
}

<section class="booking">
    <h1>Search Bookings</h1>

    <form asp-action="Index" method="post" class="booking-form">
        <div class="form-group">
            <label for="StartDate">Start Date:</label>
            <input type="date" asp-for="StartDate" id="StartDate" />
        </div>

        <div class="form-group">
            <label for="EndDate">End Date:</label>
            <input type="date" asp-for="EndDate" id="EndDate" />
        </div>

        <div class="form-group">
            <label for="Username">Username:</label>
            <input type="text" asp-for="Username" id="Username" placeholder="Enter username" />
        </div>

        <div class="form-group">
            <label for="SpaceName">Space Name:</label>
            <input type="text" asp-for="SpaceName" id="SpaceName" placeholder="Enter space name" />
        </div>

        <button type="submit" class="btn">Search</button>
    </form>

    @if (Model.Results != null && Model.Results.Any())
    {
        <table class="table" style="margin-top:30px;">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>User</th>
                    <th>Space</th>
                    <th>Start</th>
                    <th>End</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Results)
            {
                <tr>
                    <td>@item.BookingId</td>
                    <td>@item.UserName</td>
                    <td>@item.SpaceName</td>
                    <td>@item.StartTime.LocalDateTime.ToString("g")</td>
                    <td>@item.EndTime.LocalDateTime.ToString("g")</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else if (Model.Results != null)
    {
        <p style="margin-top: 20px; color: #6c5b7a;">No results found for the given criteria.</p>
    }
</section>

<style>
    body {
        background-color: #f5f4f8;
    }

    .booking {
        max-width: 600px;
        margin: 80px auto;
        padding: 40px;
        text-align: left;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    .booking h1 {
        text-align: center;
        font-size: 1.8rem;
        margin-bottom: 25px;
        font-weight: 600;
        color: #4a3f5a;
    }

    .booking-form .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 15px;
    }

    .booking-form label {
        margin-bottom: 5px;
        font-weight: 500;
        color: #6c5b7a;
    }

    .booking-form input[type="date"],
    .booking-form input[type="text"] {
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        font-size: 0.95rem;
    }

    .btn {
        width: 100%;
        padding: 12px;
        margin-top: 10px;
        border-radius: 8px;
        background-color: #b8a4f3;
        color: #4a3f5a;
        font-weight: 600;
        font-size: 0.95rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn:hover {
        background-color: #a28ee1;
        transform: translateY(-1px);
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    .table th, .table td {
        border: 1px solid #ccc;
        padding: 10px;
        text-align: center;
        font-size: 0.95rem;
    }

    .table th {
        background-color: #b8a4f3;
        color: #4a3f5a;
    }
</style>
