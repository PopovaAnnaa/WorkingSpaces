@model WorkingSpaces.Models.RegisterViewModel
@{
    ViewData["Title"] = "Реєстрація користувача";
}

<section class="register">
    <h1>Реєстрація</h1>
    <form id="registerForm" asp-controller="Account" asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        
        <div class="form-group">
            <label asp-for="UserName">Ім'я користувача</label>
            <input type="text" asp-for="UserName"/>
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FullName">Повне ім'я</label>
            <input type="text" asp-for="FullName"/>
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FullName">Електронна пошта</label>
            <input type="email" placeholder="example@domain.com" asp-for="Email"/>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber">Телефон</label>
            <input type="tel" placeholder="+380XXXXXXXXX" asp-for="PhoneNumber"/>
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Пароль</label>
            <input type="password" asp-for="Password"/>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="PasswordConfirmation">Підтвердження пароля</label>
            <input type="password" asp-for="PasswordConfirmation"/>
            <span asp-validation-for="PasswordConfirmation" class="text-danger"></span>
        </div>

        <button type="submit" class="btn">Зареєструватися</button>
    </form>
</section>

